# Packages/com.robbie111.google-signin/Editor/GoogleSignInDependencies.xml
/SampleProject/Assets/ExternalDependencyManager/
/SampleProject/Assets/Plugins/Android/
/SampleProject/ProjectSettings/AndroidResolverDependencies.xml
/SampleProject/ProjectSettings/GvhProjectSettings.xml

